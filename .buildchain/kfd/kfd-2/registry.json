{
  "schema": "kungfu-buildchain-kfd-2-product-claims-registry/v1",
  "kfd": {
    "standard": "kfd-2",
    "contract": "kfd-2-release-claims",
    "interfaceVersion": 1
  },
  "product": {
    "name": "Agent Hub Demo",
    "package": "@kungfu-tech/agent-hub-demo"
  },
  "releaseDefaults": {
    "channel": "alpha",
    "tagPrefix": "v"
  },
  "buildchain": {
    "checkCommand": "npx --yes --package @kungfu-tech/buildchain@3.0.4 buildchain kfd 2 product-claims check --json"
  },
  "claims": [
    {
      "id": "first-party-clean-room-structural-independence",
      "statement": "The first-party demo uses two independently initialized file-backed content-addressed Hub stores and preserves the exact public KFD Agent Hub profile roots exercised by the release qualification workflow.",
      "category": "first-party-structure",
      "source": {
        "path": "README.md"
      },
      "evidence": [
        {
          "path": "test/hub.test.js",
          "description": "First-party behavioral tests for independent Hub state, delivery, conflict visibility, and export/import drift rejection."
        },
        {
          "path": ".buildchain/kfd/agent-hub.json",
          "description": "Pinned public KFD Agent Hub declaration and exact tested capability scope."
        }
      ],
      "artifacts": [
        {
          "name": "Agent Hub adapter",
          "path": "src/adapter.js",
          "expectedPackagePath": "src/adapter.js"
        }
      ],
      "verification": {
        "command": "npm run qualify:release",
        "expectedResult": "pass"
      },
      "auditBoundary": {
        "scope": "First-party agent-hub-demo source, generated product artifact, and the exact KFD Agent Hub 20-vector suite pinned by the public dependency lock.",
        "enumerability": "closed-world",
        "exclusions": [
          "Third-party Hub implementations",
          "Network transports and hosted services",
          "Performance, security, or production certification"
        ]
      },
      "residualRisk": [
        {
          "id": "declared-first-party-boundary",
          "definedBy": "https://kfd.libkungfu.dev/schemas/kfd-2/trust-taxonomy.schema.json#/$defs/residualRisk",
          "riskType": "partial-machine-coverage-risk",
          "trustImpact": "downgrade-warning",
          "machineProvability": "not-exhaustively-enumerable",
          "agentAction": "accept-with-warning",
          "reason": "Passing evidence does not establish general interoperability or certification beyond the declared first-party clean-room boundary.",
          "owner": "kungfu-systems/agent-hub-demo maintainers"
        }
      ],
      "responsibility": {
        "sourceOwner": "kungfu-systems/agent-hub-demo maintainers",
        "verificationOwner": "Public KFD and Buildchain verifiers",
        "releaseDecisionOwner": "kungfu-systems release maintainers"
      },
      "status": "audited"
    }
  ]
}
