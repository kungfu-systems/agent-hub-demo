{
  "name": "@kungfu-tech/agent-hub-demo",
  "version": "0.1.0-alpha.1",
  "description": "A clean-room KFD Agent Hub demonstration using a file-backed content-addressed store.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "auditable-demo:check": "node scripts/materialize-auditable-demo.mjs check --repo-root .",
    "auditable-demo:materialize": "node scripts/materialize-auditable-demo.mjs update",
    "build": "node scripts/build.mjs",
    "check": "npm run test && npm run runtime100 && npm run build",
    "demo": "node src/cli.js demo",
    "inspect": "node src/adapter.js inspect",
    "prepare:release-evidence": "node scripts/prepare-release-evidence.mjs",
    "qualify:buildchain-release": "node scripts/qualify-buildchain-release.mjs",
    "qualify:passport": "node scripts/qualify-passport.mjs",
    "qualify:release": "node scripts/qualify-release.mjs",
    "runtime100": "node src/adapter.js run --scenario runtime-100",
    "test": "node --test"
  },
  "dependencies": {
    "@kungfu-tech/kfd": "1.0.0-alpha.42"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kungfu-systems/agent-hub-demo.git"
  }
}
