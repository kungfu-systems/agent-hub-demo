{
  "name": "@kungfu-tech/agent-hub-demo",
  "version": "0.2.0-alpha.8",
  "description": "A clean-room KFD Agent Hub demonstration using a file-backed content-addressed store.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "bin": {
    "agent-hub-demo": "src/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run generate:embedded && node scripts/build.mjs",
    "check": "npm run test && npm run runtime100 && npm run build",
    "check:embedded": "node scripts/generate-embedded-facts.mjs --check",
    "demo": "node src/cli.js demo",
    "generate:embedded": "node scripts/generate-embedded-facts.mjs",
    "inspect": "node src/adapter.js inspect",
    "precheck": "npm run generate:embedded",
    "pretest": "npm run check:embedded",
    "prepare:release-evidence": "node scripts/prepare-release-evidence.mjs",
    "qualify:buildchain-release": "node scripts/qualify-buildchain-release.mjs",
    "qualify:passport": "node scripts/qualify-passport.mjs",
    "qualify:release": "node scripts/qualify-release.mjs",
    "runtime100": "node src/adapter.js run --scenario runtime-100",
    "test": "node --test",
    "verify:signed-binary": "node scripts/verify-signed-binary.mjs",
    "verify:signed-release": "npm run test && npm run runtime100 && npm run verify:signed-binary && npm run qualify:buildchain-release"
  },
  "dependencies": {
    "@kungfu-tech/kfd": "1.0.0-alpha.42"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kungfu-systems/agent-hub-demo.git"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "postject": "1.0.0-alpha.6"
  }
}
