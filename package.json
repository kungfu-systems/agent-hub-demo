{
  "name": "@kungfu-tech/agent-hub-demo",
  "version": "0.1.0-alpha.0",
  "description": "A clean-room KFD Agent Hub demonstration using a file-backed content-addressed store.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run test && npm run runtime100 && npm run build",
    "demo": "node src/cli.js demo",
    "inspect": "node src/adapter.js inspect",
    "runtime100": "node src/adapter.js run --scenario runtime-100",
    "test": "node --test"
  },
  "dependencies": {
    "@kungfu-tech/kfd": "1.0.0-alpha.40"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kungfu-systems/agent-hub-demo.git"
  }
}
